{
  "transfer": {
    "notes": "<UNIQUE_TRANSFER_NOTES>",
    "scenario": "live_migration",
    "origin_endpoint_id": "<SOURCE_ENDPOINT_ID>",
    "destination_endpoint_id": "<DESTINATION_ENDPOINT_ID>",
    "instances": [
      "<SOURCE_INSTANCE_ID>"
    ],
    "source_environment": {
      "replica_export_mechanism": "swift_backups"
    },
    "destination_environment": {
      "migr_image_map": {
        "linux": "<WORKER_LINUX_IMAGE_ID>"
      },
      "migr_network": "<WORKER_NETWORK_ID>",
      "migr_flavor_name": "<WORKER_FLAVOR_NAME>",
      "migr_worker_use_fip": true,
      "migr_fip_pool_name": "<WORKER_FLOATING_IP_POOL>",
      "migr_worker_volume_type": "__DEFAULT__",
      "security_groups": [
        "<WORKER_SECURITY_GROUP_NAME>"
      ],
      "keypair_name": "<WORKER_KEYPAIR_NAME>",
      "use_floating_ip": true,
      "floating_ip_pool": "<DESTINATION_FLOATING_IP_POOL>",
      "preserve_fixed_ips": false
    },
    "network_map": {
      "<SOURCE_NETWORK_NAME>": "<DESTINATION_NETWORK_ID>"
    },
    "storage_mappings": {
      "default": "__DEFAULT__"
    },
    "clone_disks": true,
    "skip_os_morphing": true
  },
  "execution": {
    "shutdown_instances": true,
    "auto_deploy": true
  }
}
