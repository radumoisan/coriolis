{
  "transfer": {
    "notes": "<UNIQUE_TRANSFER_NOTES>", // Unique label; no existing transfer or deployment may use it.
    "scenario": "live_migration", // Required Coriolis live-migration scenario.
    "origin_endpoint_id": "<SOURCE_ENDPOINT_ID>", // Source endpoint UUID from the Web UI.
    "destination_endpoint_id": "<DESTINATION_ENDPOINT_ID>", // Destination endpoint UUID from the Web UI.
    "instances": [
      "<SOURCE_INSTANCE_ID>" // Source fixture instance UUID.
    ],
    "source_environment": {
      "replica_export_mechanism": "swift_backups" // Use the verified Swift backup export path.
    },
    "destination_environment": {
      "migr_image_map": {
        "linux": "<WORKER_LINUX_IMAGE_ID>" // Linux image for the temporary migration worker.
      },
      "migr_network": "<WORKER_NETWORK_ID>", // Network for the temporary migration worker.
      "migr_flavor_name": "<WORKER_FLAVOR_NAME>", // Flavor for the temporary migration worker.
      "migr_worker_use_fip": true, // Give the temporary worker a floating IP.
      "migr_fip_pool_name": "<WORKER_FLOATING_IP_POOL>", // Floating-IP pool for the temporary worker.
      "migr_worker_volume_type": "__DEFAULT__", // Worker volume type; __DEFAULT__ permits destination placement.
      "security_groups": [
        "<WORKER_SECURITY_GROUP_NAME>" // Security group for the temporary migration worker.
      ],
      "keypair_name": "<WORKER_KEYPAIR_NAME>", // Keypair for the temporary migration worker.
      "use_floating_ip": true, // Give the deployed destination instance a floating IP.
      "floating_ip_pool": "<DESTINATION_FLOATING_IP_POOL>", // Floating-IP pool for the deployed destination instance.
      "preserve_fixed_ips": false // Do not preserve source fixed IPs on the destination.
    },
    "network_map": {
      "<SOURCE_NETWORK_NAME>": "<DESTINATION_NETWORK_ID>" // Map each source NIC network name to a destination network ID.
    },
    "storage_mappings": {
      "default": "__DEFAULT__" // Let the destination choose disk placement.
    },
    "clone_disks": true, // Clone disks for this proof-of-concept path.
    "skip_os_morphing": true // Use only for the known-compatible disposable fixture.
  },
  "execution": {
    "shutdown_instances": true, // Shut down the source instance after migration.
    "auto_deploy": true // Automatically deploy the migrated destination instance.
  }
}
