{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "low"
    },
    "general": {
      "model": "opencode-go/qwen3.8-flash",
      "variant": "medium"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--headless",
        "--browser",
        "chromium",
        "--isolated"
      ],
      "enabled": true
    }
  }
}
